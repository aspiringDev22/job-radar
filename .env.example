# Absolute site URL used in the sitemap and job-page metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string. Neon and Supabase both work.
# The database must allow CREATE EXTENSION vector (the Docker image in this repo includes it).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/jobradar

# Password for /admin pages (HTTP Basic; any user name). /admin returns 404 while unset.
ADMIN_PASSWORD=

# Auth.js (Phase 4). Generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Anthropic. Used later for CV parsing and one-line "why this fits" notes.
ANTHROPIC_API_KEY=

# Embeddings provider (Phase 5). The app will call a small interface so this can be swapped.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
